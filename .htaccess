# Canonical host + HTTPS for the OVH-hosted site.
#
# Canonical: https://www.ledgera.tech. The bare apex and any plain-HTTP
# request are 301-redirected there. OVH shared hosting runs Apache with
# mod_rewrite, and sits behind a load balancer, so HTTPS is detected via both
# %{HTTPS} and the X-Forwarded-Proto header.
#
# www is canonical because OVH reliably issues/serves its Let's Encrypt cert;
# the apex cert proved flaky to keep deployed. Once both certs coexist stably
# this can be flipped back to apex-canonical by swapping the rule below.

RewriteEngine On

# ledgera.tech → www.ledgera.tech (preserve path + query)
RewriteCond %{HTTP_HOST} ^ledgera\.tech$ [NC]
RewriteRule ^ https://www.ledgera.tech%{REQUEST_URI} [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
